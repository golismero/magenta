    title_unhandled_errors: "Information Exposure in GraphQL Error Messages",

    cause_alias_overloading: "Alias overloading was found to be enabled.",
    cause_batch_queries: "Array-based query batching was found to be allowed.",
    cause_get_based_queries: "GraphQL queries via the GET method were found to be allowed.",
    cause_post_based_queries: "GraphQL queries via web forms (POST requests with `application/x-www-form-urlencoded` content) were found to be allowed.",
    cause_trace: "GraphQL trace mode (debug output) was found to be enabled.",
    cause_field_duplication: "Repeated fields within a single GraphQL operation were found to be allowed.",
    cause_field_suggestions: "GraphQL field suggestions (\"did you mean\") were found to be enabled.",
    cause_ide: "A GraphQL IDE (such as GraphiQL or GraphQL Playground) was found to be exposed.",
    cause_introspection: "GraphQL introspection was found to be enabled.",
    cause_directives_overloading: "Directives overloading was found to be enabled.",
    cause_circular_query: "Circular queries via introspection were found to be allowed.",
    cause_mutation_over_get: "GraphQL mutations via the GET method were found to be allowed.",
    cause_unhandled_errors: "The GraphQL endpoint was found to return detailed error messages (such as stack traces) for unhandled exceptions.",

    consequence_dos: "This may be abused to cause a Denial of Service condition due to excessive algorithmic complexity.",
    consequence_csrf: "This may lead to the service becoming vulnerable to Cross-Site Request Forgery (CSRF) attacks.",
    consequence_infoleak: "While this is not in itself an exploitable vulnerability, detailed information given to adversaries may facilitate attacks.",

    solution_alias_overloading: "Limit the number of aliases permitted per query, or enforce a maximum query complexity score that accounts for aliased fields. Query complexity analysis plugins (such as `graphql-cost-analysis`) can enforce these limits at the resolver level.",
    solution_batch_queries: "Disable batched queries if the application does not require this feature. If batching is required, enforce a strict cap on the number of operations per request and apply rate limiting per client.",
    solution_get_based_queries: "Restrict the GraphQL endpoint to accept queries only over the POST method. Reject GET requests entirely, and configure intermediaries (load balancers, CDNs) to never cache responses from the GraphQL endpoint.",
    solution_post_based_queries: "Require the `Content-Type: application/json` header on every GraphQL request. This forces browsers to issue a CORS preflight, which prevents simple cross-origin POST requests from triggering state changes.",
    solution_trace: "Disable trace, debug, and tracing extensions on the GraphQL endpoint in production. These features expose internal timings, file paths, and execution details that aid in reconnaissance.",
    solution_field_duplication: "Reject queries that repeat the same field within an operation, either by enforcing schema validation rules or by configuring the GraphQL server to deduplicate fields and apply per-query cost limits.",
    solution_field_suggestions: "Disable field suggestions in production so that error responses to invalid queries do not reveal the structure of the schema. Most GraphQL servers expose this as a configuration flag.",
    solution_ide: "Disable the GraphQL IDE in production environments. Restrict access to development or staging environments only, ideally behind authentication or on an internal network.",
    solution_introspection: "Disable introspection in production. Most GraphQL frameworks support a configuration flag (e.g. Apollo Server's `introspection: false`, or GraphQL.js's `NoSchemaIntrospectionCustomRule`) that prevents clients from querying `__schema` or `__type`.",
    solution_directives_overloading: "Limit the number of directives permitted per field or per query. Query complexity analysis plugins can be configured to assign a cost to directives and reject queries that exceed a defined threshold.",
    solution_circular_query: "Disable introspection in production, which removes the root cause. Additionally, enforce a maximum query depth limit on the GraphQL server to prevent recursive queries from being processed.",
    solution_mutation_over_get: "Restrict mutations to the POST method only. State-changing operations served over GET are vulnerable to Cross-Site Request Forgery (CSRF) and may also be cached by intermediaries.",
    solution_unhandled_errors: "Catch unhandled exceptions at the resolver or middleware level and return a generic error message to clients in production. Log detailed error information server-side only.",

    details: "",

    references: [
        "https://portswigger.net/web-security/graphql",
    ],

    taxonomy: [
        "CWE-200",
    ],
}
